# ════════════════════════════════════════════════════════════════════════════
# MULTI-STAGE DOCKERFILE - Vite React Application
# Generated by Opsera Code-to-Cloud Enterprise v0.903
# ════════════════════════════════════════════════════════════════════════════

# Stage 1: Build
FROM node:20-alpine AS builder

WORKDIR /app

# Copy package files first for better layer caching
COPY package*.json ./

# RULE 13: Use npm install --legacy-peer-deps (more forgiving than npm ci)
RUN npm install --legacy-peer-deps

# Copy source code
COPY . .

# Build arguments for Vite environment variables (Learning #211)
ARG VITE_SUPABASE_URL
ARG VITE_SUPABASE_ANON_KEY

# Set environment variables for build
ENV VITE_SUPABASE_URL=$VITE_SUPABASE_URL
ENV VITE_SUPABASE_ANON_KEY=$VITE_SUPABASE_ANON_KEY

# Build the application
RUN npm run build

# Stage 2: Production
# RULE 74: Use nginx-unprivileged for non-root security contexts
FROM nginxinc/nginx-unprivileged:alpine

# Copy custom nginx configuration
COPY --from=builder /app/.opsera-event-demo-1/nginx.conf /etc/nginx/conf.d/default.conf

# Copy built assets from builder stage
COPY --from=builder /app/dist /usr/share/nginx/html

# RULE 33: Set proper permissions for nginx directories
USER root
RUN mkdir -p /var/cache/nginx/client_temp \
    /var/cache/nginx/proxy_temp \
    /var/cache/nginx/fastcgi_temp \
    /var/cache/nginx/uwsgi_temp \
    /var/cache/nginx/scgi_temp \
    /var/log/nginx \
    && chmod -R 777 /var/cache/nginx \
    && chmod -R 777 /var/log/nginx \
    && touch /var/run/nginx.pid \
    && chmod 777 /var/run/nginx.pid

# Switch back to non-root user
USER nginx

# Expose port 80
EXPOSE 80

# Health check endpoint
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://localhost:80/ || exit 1

# Start nginx
CMD ["nginx", "-g", "daemon off;"]
